node_modules/
.DS_Store

# Written by the engine when it loads the mod: types for editing, not shipped.
mod/.claude/
mod/.claude-plugin/types/

# Generated by `npm run build`. mod/hooks/sprites.ts and mod/mascots/ are
# generated too, but they're what the plugin ships, so they stay.
mascots/*/export/*
# Except Maudette's: exported from .aseprite files, committed so the build
# works without Aseprite.
!mascots/maudette/export/*
mascots/*/*.mascot.json
docs/preview.html

