{
  "name": "maudette",
  "private": true,
  "type": "module",
  "scripts": {
    "export:art": "node build/export.mjs",
    "build:sprites": "node build/sprites.mjs && node build/preview.mjs",
    "build": "node build/build-all.mjs && node build/preview.mjs",
    "typecheck": "tsc -p mod",
    "validate": "node build/claude.mjs plugin validate mod",
    "dev": "node build/claude.mjs --plugin-dir mod",
    "preview": "node build/preview.mjs",
    "test": "node build/claude.mjs plugin test mod",
    "sync": "node build/sync.mjs",
    "update": "npm run build && npm run sync",
    "mascot:install": "node build/export.mjs && node build/sprites.mjs --compile-only && node build/install-mascot.mjs",
    "capture": "node build/capture.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.6.0"
  },
  "author": "Michael Hansen",
  "license": "MIT AND CC-BY-NC-4.0"
}
